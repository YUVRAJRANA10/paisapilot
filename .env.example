# Frontend
VITE_APP_MODE=demo
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_ORIGIN=http://localhost:5000

# Backend defaults are also documented in backend/.env.example. Copy that
# file to backend/.env for local backend development; never commit the copy.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# Authentication and scheduled jobs
JWT_SECRET=replace-with-a-long-random-development-secret
COOKIE_NAME=paisapilot_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CRON_SECRET=replace-with-a-long-random-cron-secret

# Optional email provider; leave unset to disable email delivery
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
